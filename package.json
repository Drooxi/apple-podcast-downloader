{
  "name": "apple-podcast-downloader",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "build": "vite build",
    "generate:icons": "node scripts/generate-icons.cjs",
    "make": "npm run generate:icons && npm run build && electron-forge make",
    "check:release-version": "node scripts/check-release-version.cjs",
    "start": "electron electron/main.cjs",
    "test": "node --test"
  },
  "keywords": [],
  "author": "Drooxi",
  "license": "Unlicense",
  "description": "Desktop application for searching and downloading Apple Podcasts episodes.",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "renovate": "^44.30.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
